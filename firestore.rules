rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read, delete: if ownsUser(userId);
      allow create, update: if ownsUser(userId)
        && request.resource.data.id == userId
        && request.resource.data.daily_goal >= 5
        && request.resource.data.daily_goal <= 480;
    }

    match /progress/{entryId} {
      allow read, update, delete: if ownsUser(resource.data.user_id);
      allow create: if ownsUser(request.resource.data.user_id)
        && request.resource.data.total > 0
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total;
    }

    match /study_sessions/{sessionId} {
      allow read, update, delete: if ownsUser(resource.data.user_id);
      allow create: if ownsUser(request.resource.data.user_id)
        && request.resource.data.minutes > 0;
    }

    match /study_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.created_by == request.auth.uid;
      allow update: if signedIn()
        && resource.data.created_by == request.auth.uid
        && request.resource.data.created_by == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.created_by == request.auth.uid;
    }

    match /room_members/{membershipId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow update: if signedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.user_id == request.auth.uid;
    }
  }
}
